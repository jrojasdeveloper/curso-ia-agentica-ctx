---
/**
 * Inline SVG illustrations for published concepts (one per concept id).
 * Line-art style: thin strokes, every color resolved from theme CSS
 * variables so the same artwork works in dark and light themes.
 * Idle animations are disabled under prefers-reduced-motion in main.css.
 * Coming-soon concepts render nothing.
 * Marker ids are prefixed per scene: this file renders into one document.
 */
const { conceptId } = Astro.props;
---

{
  conceptId === 'por-que-un-agente' && (
    <svg
      class="concept-illustration"
      viewBox="0 0 340 200"
      role="img"
      aria-label="Ilustración: a la izquierda, un chat que solo responde con texto; a la derecha, un agente en su escritorio que termina la tarea con archivos, terminal y engranajes."
      focusable="false"
    >
      <defs>
        <marker
          id="arr-chat-ask"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
        </marker>
        <marker
          id="arr-chat-reply"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0 0 L10 5 L0 10 z" fill="var(--accent-2)" />
        </marker>
        <marker
          id="arr-divider"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0 0 L10 5 L0 10 z" fill="var(--text)" />
        </marker>
      </defs>

      {/* Left scene: chat question-and-answer loop (ChatGPT) */}
      <circle cx="30" cy="64" r="8" fill="none" stroke="var(--text)" stroke-width="1.8" />
      <path d="M16 96 Q30 76 44 96" fill="none" stroke="var(--text)" stroke-width="1.8" stroke-linecap="round" />
      <rect x="58" y="38" width="74" height="30" rx="10" fill="none" stroke="var(--accent)" stroke-width="1.8" />
      <text x="95" y="60" text-anchor="middle" font-size="14" fill="var(--accent)">¿…?</text>
      <path class="ill-flow" d="M42 61 L54 56" fill="none" stroke="var(--accent)" stroke-width="1.8" marker-end="url(#arr-chat-ask)" />
      <rect x="58" y="84" width="74" height="40" rx="10" fill="none" stroke="var(--node-stroke)" stroke-width="1.8" />
      <path d="M68 96 h48 M68 104 h38 M68 112 h26" fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-linecap="round" />
      <path class="ill-flow" d="M56 104 L46 88" fill="none" stroke="var(--accent-2)" stroke-width="1.8" marker-end="url(#arr-chat-reply)" />
      <text x="95" y="146" text-anchor="middle" font-size="11.5" font-weight="600" fill="var(--muted)">ChatGPT</text>

      {/* Divider arrow */}
      <path class="ill-flow" d="M150 92 L184 92" fill="none" stroke="var(--text)" stroke-width="2" marker-end="url(#arr-divider)" />

      {/* Right scene: agent at a desk completing the task */}
      <g class="ill-scene-agent">
        <line x1="200" y1="120" x2="330" y2="120" stroke="var(--text)" stroke-width="2" stroke-linecap="round" />
        <path d="M206 120 v22 M324 120 v22" stroke="var(--node-stroke)" stroke-width="1.5" fill="none" />
        <rect class="ill-glowline" x="272" y="86" width="56" height="34" rx="4" fill="none" stroke="var(--accent)" stroke-width="1.8" />
        <text class="ill-mono" x="300" y="108" text-anchor="middle" font-size="12" fill="var(--accent)">>_</text>
        <circle cx="316" cy="64" r="8" fill="none" stroke="var(--text)" stroke-width="1.7" />
        <circle cx="316" cy="64" r="11" fill="none" stroke="var(--text)" stroke-width="1.4" stroke-dasharray="2.6 3.2" />
        <circle cx="302" cy="79" r="5" fill="none" stroke="var(--text)" stroke-width="1.5" />
        <circle cx="302" cy="79" r="7" fill="none" stroke="var(--text)" stroke-width="1.3" stroke-dasharray="2.2 2.8" />
        <circle cx="226" cy="66" r="8" fill="none" stroke="var(--text)" stroke-width="1.8" />
        <path d="M214 118 Q226 78 238 118" fill="none" stroke="var(--text)" stroke-width="1.8" />
        <path d="M238 96 L254 100" fill="none" stroke="var(--text)" stroke-width="1.5" stroke-linecap="round" />
        <rect x="252" y="86" width="18" height="24" rx="3" fill="none" stroke="var(--accent-2)" stroke-width="1.8" />
        <circle cx="256" cy="66" r="8" fill="none" stroke="var(--accent)" stroke-width="1.8" />
        <path d="M252 66 l3 3 6 -7" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="265" y="146" text-anchor="middle" font-size="11.5" font-weight="600" fill="var(--muted)">Agente</text>
      </g>

      <text x="170" y="178" text-anchor="middle" font-size="10.5" fill="var(--muted)">Cambio aplicado, no solo explicado.</text>
    </svg>
  )
}

{
  conceptId === 'motor-llm' && (
    <svg
      class="concept-illustration"
      viewBox="0 0 340 190"
      role="img"
      aria-label="Ilustración: el motor del LLM alimenta la ventana de contexto; los tokens que entran se marcan con una marca de verificación y los que no caben salen del borde y sobran."
      focusable="false"
    >
      <defs>
        <marker
          id="arr-pipe"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
        </marker>
        <marker
          id="arr-sobra"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
        </marker>
      </defs>

      {/* Engine: chip and gears (the LLM) */}
      <rect x="14" y="56" width="78" height="76" rx="12" fill="none" stroke="var(--text)" stroke-width="1.8" />
      <rect x="30" y="68" width="22" height="16" rx="3" fill="none" stroke="var(--text)" stroke-width="1.5" />
      <path d="M30 72 h-5 M30 77 h-5 M30 82 h-5 M52 72 h5 M52 77 h5 M52 82 h5" stroke="var(--muted)" stroke-width="1.4" fill="none" />
      <circle cx="52" cy="106" r="10" fill="none" stroke="var(--text)" stroke-width="1.7" />
      <circle cx="52" cy="106" r="13" fill="none" stroke="var(--text)" stroke-width="1.4" stroke-dasharray="2.6 3.4" />
      <circle cx="72" cy="122" r="6" fill="none" stroke="var(--text)" stroke-width="1.5" />
      <circle cx="72" cy="122" r="8" fill="none" stroke="var(--text)" stroke-width="1.3" stroke-dasharray="2.2 3" />
      <text x="53" y="152" text-anchor="middle" font-size="11" font-weight="600" fill="var(--muted)">LLM</text>

      {/* Feed pipe into the context window */}
      <path class="ill-flow" d="M94 94 L124 94" fill="none" stroke="var(--accent)" stroke-width="2" marker-end="url(#arr-pipe)" />
      <circle cx="108" cy="114" r="7" fill="none" stroke="var(--accent)" stroke-width="1.8" />
      <path d="M104.5 114 l2.5 2.5 4.5 -5" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <text x="108" y="132" text-anchor="middle" font-size="10.5" fill="var(--accent)">entra</text>

      {/* Context window with token blocks inside */}
      <rect class="ill-glowline" x="132" y="26" width="148" height="124" rx="10" fill="none" stroke="var(--accent)" stroke-width="2" />
      <path d="M132 48 H280" stroke="var(--accent)" stroke-width="1.2" opacity="0.7" fill="none" />
      <circle cx="142" cy="37" r="2.4" fill="var(--muted)" />
      <circle cx="152" cy="37" r="2.4" fill="var(--muted)" />
      <circle cx="162" cy="37" r="2.4" fill="var(--muted)" />
      <g fill="none" stroke="var(--text)" stroke-width="1.5">
        <rect x="140" y="56" width="34" height="14" rx="3" />
        <rect x="178" y="56" width="24" height="14" rx="3" />
        <rect x="206" y="56" width="44" height="14" rx="3" />
        <rect x="254" y="56" width="20" height="14" rx="3" />
        <rect x="140" y="78" width="22" height="14" rx="3" />
        <rect x="166" y="78" width="38" height="14" rx="3" />
        <rect x="208" y="78" width="30" height="14" rx="3" />
        <rect x="242" y="78" width="16" height="14" rx="3" />
        <rect x="140" y="100" width="52" height="14" rx="3" />
        <rect x="196" y="100" width="32" height="14" rx="3" />
      </g>

      {/* Tokens that do not fit fall out of the right edge */}
      <path d="M281 101 L292 96" fill="none" stroke="var(--muted)" stroke-width="1.5" marker-end="url(#arr-sobra)" />
      <g class="ill-fall" fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="3 3">
        <rect x="298" y="78" width="16" height="11" rx="3" />
        <rect x="304" y="96" width="16" height="11" rx="3" />
        <rect x="296" y="114" width="16" height="11" rx="3" />
      </g>
      <text x="306" y="142" text-anchor="middle" font-size="10.5" fill="var(--muted)">sobra</text>
    </svg>
  )
}

{
  conceptId === 'estructura-proyecto' && (
    <svg
      class="concept-illustration"
      viewBox="0 0 340 190"
      role="img"
      aria-label="Ilustración: árbol ordenado de carpetas del proyecto con la carpeta raíz, tres carpetas etiquetadas y el archivo AGENTS.md fijado en la raíz como nota recordatoria."
      focusable="false"
    >
      {/* Root folder */}
      <rect x="16" y="16" width="114" height="30" rx="8" fill="none" stroke="var(--text)" stroke-width="1.8" />
      <text class="ill-mono" x="73" y="36" text-anchor="middle" font-size="11" fill="var(--text)">mi-proyecto/</text>

      {/* Branches */}
      <path d="M58 46 V146 M58 74 H80 M58 110 H80 M58 146 H80" fill="none" stroke="var(--text)" stroke-width="1.5" />

      {/* Folder: src */}
      <rect x="80" y="58" width="20" height="9" rx="2" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />
      <rect x="80" y="64" width="48" height="20" rx="4" fill="var(--surface)" stroke="var(--node-stroke)" stroke-width="1.5" />
      <text x="136" y="80" text-anchor="start" font-size="11" fill="var(--text)">src</text>

      {/* Folder: tests */}
      <rect x="80" y="94" width="20" height="9" rx="2" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />
      <rect x="80" y="100" width="48" height="20" rx="4" fill="var(--surface)" stroke="var(--node-stroke)" stroke-width="1.5" />
      <text x="136" y="116" text-anchor="start" font-size="11" fill="var(--text)">tests</text>

      {/* Folder: docs */}
      <rect x="80" y="130" width="20" height="9" rx="2" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />
      <rect x="80" y="136" width="48" height="20" rx="4" fill="var(--surface)" stroke="var(--node-stroke)" stroke-width="1.5" />
      <text x="136" y="152" text-anchor="start" font-size="11" fill="var(--text)">docs</text>

      {/* Pinned AGENTS.md note at the root */}
      <path d="M132 31 H194" fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="4 4" />
      <rect class="ill-glow" x="196" y="10" width="100" height="50" rx="8" fill="var(--accent-glow)" />
      <rect class="ill-glowline" x="200" y="14" width="92" height="42" rx="6" fill="none" stroke="var(--accent)" stroke-width="1.8" />
      <circle cx="246" cy="8" r="3.5" fill="none" stroke="var(--accent)" stroke-width="1.8" />
      <path d="M246 11.5 V14" stroke="var(--accent)" stroke-width="1.8" />
      <text class="ill-mono" x="246" y="32" text-anchor="middle" font-size="10.5" font-weight="600" fill="var(--accent)">AGENTS.md</text>
      <path d="M210 40 h56 M210 46 h40" fill="none" stroke="var(--muted)" stroke-width="1.2" />
    </svg>
  )
}

{
  conceptId === 'git-con-ia' && (
    <svg
      class="concept-illustration"
      viewBox="0 0 340 190"
      role="img"
      aria-label="Ilustración: una cadena de puntos de guardado (commits) con una rama de experimento, una lupa que revisa la zona de cambios y un escudo que marca el control antes de aceptar."
      focusable="false"
    >
      <defs>
        <marker
          id="arr-git-end"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
        </marker>
      </defs>

      {/* Main commit chain, left to right */}
      <path d="M18 100 H296" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />
      <path class="ill-flow" d="M296 100 L326 100" fill="none" stroke="var(--accent)" stroke-width="1.8" marker-end="url(#arr-git-end)" />

      {/* Commit snapshots; the third one is highlighted */}
      <rect x="22" y="92" width="26" height="16" rx="3" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />
      <rect x="64" y="92" width="26" height="16" rx="3" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />
      <rect class="ill-glowline" x="106" y="92" width="26" height="16" rx="3" fill="none" stroke="var(--accent)" stroke-width="1.8" />
      <rect x="148" y="92" width="26" height="16" rx="3" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />

      {/* Branch for the experiment, dashed */}
      <path d="M150 92 C160 72 172 66 190 66" fill="none" stroke="var(--node-stroke)" stroke-width="1.4" stroke-dasharray="4 4" />
      <rect x="190" y="58" width="26" height="16" rx="3" fill="none" stroke="var(--node-stroke)" stroke-width="1.4" stroke-dasharray="4 3" />
      <path d="M216 66 C238 66 252 88 262 100" fill="none" stroke="var(--node-stroke)" stroke-width="1.4" stroke-dasharray="4 4" />

      {/* Diff zone the magnifier inspects */}
      <rect x="94" y="28" width="46" height="26" rx="4" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />
      <path d="M100 37 h22" fill="none" stroke="var(--muted)" stroke-width="1.6" />
      <path d="M100 44 h30" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      <circle cx="122" cy="70" r="10" fill="none" stroke="var(--text)" stroke-width="1.7" />
      <path d="M129 77 L136 84" fill="none" stroke="var(--text)" stroke-width="1.7" stroke-linecap="round" />

      {/* Shield gate at the merge point: revise before accepting */}
      <path
        d="M281 94 l14 5 v9 c0 8-14 13-14 13 c0 0-14-5-14-13 v-9 z"
        fill="none"
        stroke="var(--accent)"
        stroke-width="1.8"
        stroke-linejoin="round"
      />
      <path d="M275 109 l4 4 8 -9" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

      <text x="170" y="178" text-anchor="middle" font-size="10.5" fill="var(--muted)">Cada cambio, un punto de guardado.</text>
    </svg>
  )
}

{
  conceptId === 'caparazon-agente' && (
    <svg
      class="concept-illustration"
      viewBox="0 0 340 190"
      role="img"
      aria-label="Ilustración: el agente en el centro, rodeado de un archivo de instrucciones AGENTS.md, tarjetas de skills, un control automático de hooks y un enchufe MCP que conecta herramientas externas."
      focusable="false"
    >
      <defs>
        <marker
          id="arr-hook-in"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
        </marker>
        <marker
          id="arr-hook-out"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
        </marker>
      </defs>

      {/* Center: the agent, softly beaming */}
      <circle cx="170" cy="100" r="36" fill="none" stroke="var(--accent)" stroke-width="1.3" stroke-dasharray="3 5" opacity="0.6" />
      <circle cx="170" cy="82" r="9" fill="none" stroke="var(--text)" stroke-width="1.8" />
      <path d="M150 130 Q170 94 190 130" fill="none" stroke="var(--text)" stroke-width="1.8" />

      {/* Connectors from the four cards to the agent */}
      <g fill="none" stroke="var(--muted)" stroke-width="1.1" stroke-dasharray="3 5" opacity="0.8">
        <path d="M110 62 L146 88" />
        <path d="M228 62 L194 88" />
        <path d="M112 142 L146 114" />
        <path d="M230 142 L194 114" />
      </g>

      {/* AGENTS.md: pinned note (permanent instructions) */}
      <rect class="ill-glow" x="14" y="14" width="96" height="48" rx="8" fill="var(--accent-glow)" />
      <rect class="ill-glowline" x="18" y="18" width="88" height="40" rx="6" fill="none" stroke="var(--accent)" stroke-width="1.8" />
      <circle cx="62" cy="12" r="3.4" fill="none" stroke="var(--accent)" stroke-width="1.8" />
      <path d="M62 15.5 V18" stroke="var(--accent)" stroke-width="1.8" />
      <text class="ill-mono" x="62" y="35" text-anchor="middle" font-size="10" font-weight="600" fill="var(--accent)">AGENTS.md</text>
      <path d="M27 43 h66 M27 49 h44" fill="none" stroke="var(--muted)" stroke-width="1.2" />

      {/* Skills: reusable recipe cards */}
      <rect x="236" y="16" width="78" height="38" rx="6" fill="none" stroke="var(--node-stroke)" stroke-width="1.4" />
      <rect x="228" y="24" width="78" height="38" rx="6" fill="var(--surface)" stroke="var(--node-stroke)" stroke-width="1.6" />
      <path d="M236 40 h54 M236 48 h40 M236 56 h48" fill="none" stroke="var(--muted)" stroke-width="1.2" />

      {/* Hooks: automatic control on events */}
      <rect x="12" y="126" width="100" height="44" rx="6" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />
      <path class="ill-flow" d="M18 148 L32 148" fill="none" stroke="var(--muted)" stroke-width="1.6" marker-end="url(#arr-hook-in)" />
      <circle cx="56" cy="148" r="9" fill="none" stroke="var(--accent)" stroke-width="1.8" />
      <path d="M52 148 l2.5 2.5 5 -5.5" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <path class="ill-flow" d="M68 148 L84 148" fill="none" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr-hook-out)" />
      <rect x="90" y="140" width="16" height="16" rx="3" fill="none" stroke="var(--node-stroke)" stroke-width="1.4" />

      {/* MCPs: one standard plug into external sockets */}
      <rect class="ill-glowline" x="232" y="140" width="28" height="16" rx="4" fill="none" stroke="var(--accent)" stroke-width="1.8" />
      <path d="M226 144 h6 M226 152 h6" fill="none" stroke="var(--accent)" stroke-width="1.6" />
      <path d="M260 148 L278 138 M260 148 L282 148 M260 148 L278 160" fill="none" stroke="var(--muted)" stroke-width="1.3" stroke-dasharray="3 4" />
      <circle cx="284" cy="136" r="4.5" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />
      <circle cx="290" cy="148" r="4.5" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />
      <circle cx="284" cy="162" r="4.5" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />
      <text x="306" y="152" font-size="10.5" font-weight="600" fill="var(--accent)">MCPs</text>

      <text x="170" y="182" text-anchor="middle" font-size="10.5" fill="var(--muted)">Instrucciones, recetas, controles y conectores.</text>
    </svg>
  )
}

{
  conceptId === 'ecosistema-ia' && (
    <svg
      class="concept-illustration"
      viewBox="0 0 340 190"
      role="img"
      aria-label="Ilustración: a la izquierda un archivador con una tarjeta abierta que fluye hacia el agente del centro como memoria (engram); a la derecha, la salida del agente pasa una compuerta de control con un escudo de verificación y una lupa (revisión) antes de salir aprobada."
      focusable="false"
    >
      <defs>
        <marker
          id="arr-eco-in"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
        </marker>
        <marker
          id="arr-eco-out"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0 0 L10 5 L0 10 z" fill="var(--accent-2)" />
        </marker>
      </defs>

      {/* Left: archiver cabinet with a glowing index card of decisions */}
      <rect x="20" y="64" width="76" height="30" rx="4" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />
      <rect x="20" y="104" width="76" height="30" rx="4" fill="none" stroke="var(--node-stroke)" stroke-width="1.5" />
      <path d="M34 79 h12 M34 119 h12" fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-linecap="round" />
      <rect class="ill-glow" x="30" y="26" width="68" height="50" rx="6" fill="var(--accent-glow)" />
      <rect class="ill-glowline" x="36" y="32" width="60" height="40" rx="4" fill="none" stroke="var(--accent)" stroke-width="1.8" />
      <path d="M44 42 h44 M44 50 h30 M44 58 h36" fill="none" stroke="var(--muted)" stroke-width="1.2" />

      {/* Memory flows from the card into the agent */}
      <path class="ill-flow" d="M100 70 L142 90" fill="none" stroke="var(--accent)" stroke-width="1.8" marker-end="url(#arr-eco-in)" />

